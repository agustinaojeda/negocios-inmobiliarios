PORT=3000
CORS_ORIGIN=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=negocios-inmobiliarios

# Clave secreta para firmar los tokens: larga y aleatoria.
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Duración del token (ej: 1h, 15m, 1m para probar el vencimiento en clase)
JWT_EXPIRES_IN=1h
